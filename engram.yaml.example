# engram.yaml — engram configuration. Copy to ~/.claude/engram.yaml (the installer
# does this for you) and edit. Missing keys fall back to defaults in memory_ai.py.
#
# engram is a neuro-inspired memory system for Claude Code: encode (harvest) ->
# consolidate (curate) -> fixate -> recall (graph). This file controls the LLM
# backend, the unattended pipeline, and the local light pass.

local_enabled: true              # master switch for ALL automated/local memory work

# ── LLM backend ─────────────────────────────────────────────────────────────
# How engram runs its LLM work (harvest/distill/injection-check/verify).
#   ollama  — local models on a GPU box (free, private). Pick a `tier` for your VRAM.
#   claude  — no GPU: shell out to the `claude` CLI headless (cost = Claude usage).
#             Used by the always-on loop container (daemon/, backend=claude).
backend: ollama                  # ollama | claude | ccg | llama_cpp
fallback: ""                     # "" | ccg | claude — when the backend is unreachable (e.g. GPU box off),
                                 # fall back so the 24/7 daemon keeps working.
                                 #   ccg    — route through cc-gateway (headless-safe; see below)
                                 #   claude — raw `claude -p` (needs a logged-in OAuth session; costs usage)

# Hardware tier (ollama only) — selects a model preset over the expert ROLES.
# See engram_llm.TIER_PRESETS. Embeddings are always local (nomic, 768-dim).
#   cpu     — no GPU; tiny 1-3B models (slow). Most cpu users should set backend: claude.
#   small   — ~8 GB VRAM  (qwen2.5-coder:7b harvest, llama3.1:8b distill/injection)
#   medium  — ~16-24 GB   (gpt-oss:20b distill, deepseek-r1:14b injection)
#   large   — >= 32 GB    (qwen3-coder:30b distill, deepseek-r1:32b injection/verify)
tier: small

ollama:
  host: "http://localhost:11434"   # your Ollama endpoint (e.g. a LAN GPU box)
  timeout_seconds: 1200            # raise for big models on slow hardware (30b on an 8GB host ~2400)
  num_ctx: 16384                   # distill prompts run ~6-8k tokens; below this Ollama silently truncates
  num_predict: 8000                # reasoning models spend output tokens on hidden CoT first; keep headroom
  think: false                     # ollama thinking toggle. reasoning_effort is a NO-OP while this is
                                   # false. CoT is stripped before the text reaches JSON-expecting
                                   # callers, so turning it on is safe — it just costs output tokens.
  reasoning_effort: "low"          # for harmony/reasoning models. ⚠ VERIFY this bites on YOUR model before
                                   # relying on it: on Qwen3.6 via ollama 0.32 /v1, "high" and "low" returned
                                   # byte-identical CoT — only "none" actually stops the thinking.
  keep_alive: "30m"                # hold the model resident so sequential stages skip cold reloads

# Claude-only backend (when backend: claude). Flags are configurable since the
# claude CLI can vary by version.
claude:
  bin: "claude"
  model: ""                        # blank = CLI default; or pin e.g. "claude-sonnet-4-6"
                                   # (the optional nightly apply job reads this too — pin a strong
                                   #  model like "claude-opus-4-8" if you enable memory-nightly-apply)
  timeout_seconds: 600
  max_turns: 1                     # single turn, no tool loop — pure text generation

# cc-gateway backend (backend: ccg). Runs the SAME claude CLI but pointed at the
# cc-gateway OAuth proxy: it sends a client key as x-api-key and ccg swaps it for the
# real Claude.ai OAuth token. This is HEADLESS-SAFE — the daemon needs no local logged-in
# session (raw `claude` fails "Not logged in" under systemd when the OAuth token is
# expired/absent). The client key is read from an ENV VAR (never the repo): put it in the
# service EnvironmentFile (~/.config/engram/daemon.env), mode 600. Typical setup:
#   backend: ccg   fallback: claude   (ccg for hosts behind the proxy; raw claude elsewhere)
ccg:
  base_url: "http://10.0.0.2:8443"      # ccg endpoint (ANTHROPIC_BASE_URL). Falls back to $ANTHROPIC_BASE_URL.
  api_key_env: "ENGRAM_CCG_KEY"         # env var holding the ccg client key (or $ANTHROPIC_API_KEY)
  model: "claude-opus-4-8"              # model id ccg/Anthropic accepts
  # bin / timeout_seconds / max_turns inherit from the `claude:` block unless set here

# Daemon task cadences (override engram-daemon.py DEFAULT_INTERVALS, in seconds).
# Default "quiet fleet" cadence: every heavy memory task runs ONCE A DAY. The 30-min
# systemd timer still ticks so the cheap probes (health, approvals) stay responsive —
# only the DUE heavy tasks below fire per their interval. Raise/lower per-host as needed.
daemon:
  intervals:
    harvest: 86400      # encode finished chats -> staging  (once/day)
    graph: 86400        # graph_sync.py --insert            (once/day)
    vector: 86400       # vector_sync.py --insert           (once/day)
    maintenance: 86400  # nightly fixate + light-pass pipeline (distill gated inside the cron)

# ── Backups (encrypted, off-host) ───────────────────────────────────────────
# Daily restic backup of the AUTHORITATIVE data — the .md memory stores and the
# Obsidian vaults, plus engram.yaml and graph/.env so a restore stands the system
# back up. The Qdrant/Neo4j indexes are NOT backed up: they rebuild from the .md
# store. Off by default; the daemon's `backup` task no-ops until you enable it and
# provide credentials.
#
# SECRETS DO NOT GO HERE. The restic password and the S3/B2 keys live in
# ~/.config/engram/daemon.env (mode 600), never in this file:
#   ENGRAM_BACKUP_PASSWORD   restic encryption password
#   ENGRAM_BACKUP_S3_KEY_ID  B2/S3 application key id
#   ENGRAM_BACKUP_S3_KEY     B2/S3 application key
# restic encrypts client-side, so Backblaze never sees plaintext — which also
# means: LOSE THE PASSWORD AND THE BACKUPS ARE UNRECOVERABLE. Store it in a
# password manager. `./install.sh --backup` provisions all of this for you.
backup:
  enabled: false
  provider: b2                                 # label only; any S3-compatible store works
  endpoint: "s3.us-west-004.backblazeb2.com"   # your bucket's S3 endpoint
  bucket: ""                                   # e.g. engram-backups
  prefix: "engram"                             # path within the bucket
  include_vaults: true
  retention: { daily: 7, weekly: 4, monthly: 6 }
  check_every_days: 7                          # periodic restic integrity check

# OpenAI-compatible llama.cpp server (llama-server /v1). Used when backend: llama_cpp.
# Generation routes to {url}/chat/completions; <think>…</think> reasoning is stripped.
llama_cpp:
  url: "http://localhost:8080/v1"   # llama-server base URL (must include /v1)
  model: "local"                    # the --alias your llama-server reports (e.g. qwen3-14b)
  timeout_seconds: 600
  max_tokens: 8000
  api_key: ""                       # only if your llama-server requires one
  enable_thinking: false            # true to let a reasoning model emit <think>; engram
                                    # callers want JSON, and thinking eats the budget

# Embeddings — local by default, never a paid API. The provider is chosen
# INDEPENDENTLY of the generation backend, so backend: llama_cpp (or claude) can
# still embed via Ollama.
#   provider: "" (auto: ollama when backend=ollama, else fastembed)
#             | ollama | fastembed          -> served by the PYTHON indexer
#             | llama_cpp | openai          -> any OpenAI-compatible /v1 endpoint,
#                                              and the only providers the RUST
#                                              indexer/graph-sync implement
#   url:      required for llama_cpp/openai; blank falls back to llama_cpp.url
#   model:    embedding model, e.g. "bge-m3" (1024-dim). Blank = nomic.
#   dim:      MUST match the model's output (nomic/fastembed=768, bge-m3=1024).
#             A mismatch is now an error rather than a silently wrong vector.
#   query_prefix / document_prefix: asymmetric models (bge, e5, nomic) need these.
#             Applied to queries and indexed documents respectively; changing
#             either changes the embedding space and requires a reindex.
#
# NOTE: an EXPLICIT provider never falls back. If you name llama_cpp and the server
# is down, embedding fails loudly instead of quietly answering from a different
# model in a different dimension and poisoning the index.
embed:
  provider: ""
  url: ""
  model: ""
  api_key: ""                    # only if your embedding server requires one
  timeout_seconds: 0             # 0 = inherit llama_cpp.timeout_seconds, else 90
  fastembed_model: "nomic-ai/nomic-embed-text-v1.5"
  dim: 768
  query_prefix: ""
  document_prefix: ""

# Graph recall backend.
#
# graphiti_compat (the default, including when this whole block is absent) invokes
# the pinned Graphiti recall path and returns ITS ordering untouched — the outer
# keyword and vector legs are deliberately disabled so compatibility mode cannot
# change Graphiti's ranking. It is compatibility, not hybrid fusion.
#
# native uses the Rust/Neo4j schema. Node identity includes the memory slug, so
# switching to it needs a rebuild; it is still the unproven path.
# ── Tenants: agent identities ───────────────────────────────────────────────
# A tenant is one agent's world — the memory stores it owns, and (optionally) the
# Obsidian vault it reads. Its purpose is isolation: a "work" agent must never
# recall a "homelab" memory or wiki page, and vice versa.
#
# LEAVE THIS BLOCK OUT and nothing changes. An absent `tenants:` block means
# tenancy is off, and engram behaves exactly as it did before: one shared Qdrant
# collection, Graphiti's historical "canonical" group, the slug resolved the usual
# way. That is the upgrade path, and it is the default.
#
# ADD EVEN ONE TENANT and the identity follows the store: naming a slug determines
# the tenant, because the mapping below is total and has exactly one right answer.
# --tenant is needed only where no store can be determined — the engram-app service
# (one identity per process, no project directory to derive from) and the daemon's
# children, which pass it explicitly per store. A store no tenant claims is REFUSED,
# never adopted. There is still no default tenant when none can be derived.
# Each tenant gets its own Qdrant collections
# (engram_memory__<name>, engram_wiki__<name>) and its own Neo4j group, so
# reaching another identity's data requires NAMING it rather than forgetting a
# filter.
#
# Moving existing stores into tenants requires a migration (the Qdrant points must
# be reindexed and the Graphiti episodes re-inserted under their new group) — see
# `engram-tenant-migrate`. A slug may belong to exactly one tenant; two tenants
# claiming the same store is a config error, because that IS the leak.
#
# tenants:
#   work-company-x:
#     slugs: ["-root-MJSV", "-root-dsec-lab"]   # the memory stores it owns
#     vault: /vaults/work                       # absolute; optional (stores-only is fine)
#     agent_subtree: _agent                     # the ONLY place an agent may write
#     extract_facts: false                      # LLM facts per wiki section (costly)
#   homelab:
#     slugs: ["-root", "-root-ASCP"]
#     vault: /vaults/homelab

# ── UI (atlas dashboard) ────────────────────────────────────────────────────
# ui:
#   # Host suffix for the per-tenant "Wiki" link in atlas, which opens a tenant's
#   # SilverBullet vault at https://wiki-<tenant>.<suffix>. Must match the
#   # SB_HOST_SUFFIX used by `./install.sh --silverbullet`. Default: home.arpa.
#   wiki_host_suffix: home.arpa

graph:
  backend: graphiti_compat       # graphiti_compat | native
  neo4j_uri: "bolt://127.0.0.1:7687"
  neo4j_database: "neo4j"
  neo4j_user: "neo4j"
  # Password normally lives in graph/.env (mode 600), written by the installer.
  neo4j_password: ""
  # Required for a NON-loopback Neo4j: basic-auth credentials must not cross a
  # network in plaintext, so a remote host needs an explicit https endpoint.
  neo4j_http_url: ""             # e.g. "https://neo.example:7473"

# OPTIONAL per-role model override. Leave empty to let `tier` decide. Pin a role
# only if you want a specific model regardless of tier, e.g.:
# experts:
#   distill: { model: "qwen3-coder:30b" }
experts: {}

# ── Light pass (cheap, twice-daily, NO destructive mutation) ─────────────────
light_pass:
  enabled: true
  duplicate_finder:
    enabled: true
    expert: "similarity"
    dup_threshold: 0.86            # cosine >= this => flagged as near-duplicate
  injection_guard:
    enabled: true
    quarantine_suspects: true      # auto-move suspect memories out of recall (reversible)
  draft_distill: true
  distill_every_days: 7            # LLM distillation cadence (weekly — survival passes mint "fixed")              # DRAFT (never apply) cluster merges
  max_items: 60

# ── Unattended pipeline (stages ①→⑤) ────────────────────────────────────────
# ① harvest transcripts -> .staging/   ②/④ graduate clean candidates -> recall
# ⑤ promote fixated user-direct memories -> installed skills
# The `enabled` flags below are LIGHTS-OUT switches. They ship OFF: the pipeline
# runs every stage in DRY-RUN so you can watch it before granting unattended writes.
harvest:
  max_files_per_run: 4
  idle_minutes: 30              # only harvest a chat idle >= this (finished session); avoids paying tokens on an active chat

auto_graduate:                     # stage ②/④
  enabled: false                   # OFF by default — flip on once you trust the harvester's output
  allow_provenance: ["user-direct"]   # add "assistant" to also graduate passive assistant-authored memories (injection+secret+dedup screened)
  min_confidence: 0.6                # bar for user-direct
  assistant_min_confidence: 0.75     # HIGHER bar applied when "assistant" is in allow_provenance
  dedup_threshold: 0.86
  injection_check: true
  staging_ttl_days: 14
  max_per_run: 8

# Deterministic auto-consolidation (compress-then-quarantine). Merges near-duplicate
# memories (Qdrant ANN cosine >= merge_threshold, SAME type) into a compressed umbrella;
# sources go to .quarantine/ (30-day probation, restorable) NOT trashed. Each merge is
# reviewed by Codex: clean -> auto-apply + a one-tap UNDO on Telegram; deferred -> the
# approval queue. OFF by default. Needs the vector store + (ideally) the Telegram gate.
auto_curate:
  enabled: false
  merge_threshold: 0.92            # cosine >= this to auto-merge (high = only true near-dups)
  max_merges_per_run: 2
  review_gate: auto                # auto | codex | human. 'auto' uses Codex if installed, ELSE falls
                                   # back to a HUMAN Telegram approval for every merge. Most users have
                                   # only Claude (no Codex) -> 'auto' = human-gated, safely. 'human' forces
                                   # it; 'codex' forces Codex. There is no unreviewed auto-apply mode.

# Async human-approval gate (Telegram). For the irreversible/behavioral ops: skill
# installs (always), Codex-deferred merges, purges. Long-poll (no webhook). Put the
# bot token + your chat id in ~/.config/engram/daemon.env (mode 600), never here:
#   TELEGRAM_BOT_TOKEN=...   TELEGRAM_CHAT_ID=...
# 72h TTL then DROP (never default-apply). Works headless without a token (local
# `engram_telegram_gate.py --approve <id>`).

skill_autoinstall:                 # stage ⑤
  enabled: false                   # OFF by default (kill-switch: touch ~/.claude/skills/auto/.disabled)
  require_user_direct: true        # only user-direct memories are skill-eligible
  adversarial_review: true         # injection expert sanity pass (advisory)
  max_per_run: 1
  max_candidates_per_run: 3

# Per-session trigger: a Stop hook launches ONE background curate subagent when a
# session ran long enough and added enough new memories.
# Set enabled: false if you prefer human-gated /memory-curate, or the nightly job below.
session_curate:
  enabled: true
  min_minutes: 15
  min_new_memories: 3
  max_per_day: 2

# OPTIONAL nightly memory maintenance (bin/memory_nightly_apply.sh + the
# memory-nightly-apply systemd timer). Once a night a headless Claude (uses
# claude.model above) runs /memory-curate + /memory-fixate and Codex-reviews the
# plan; the morning report is surfaced on the TUI by bin/codex-availability-warn.sh.
# DETERMINISTIC: the LLM is read-only and only PROPOSES a plan; a shell Codex-reviews
# each op and applies ONLY approved ones (the LLM never mutates), so a prompt injection
# can at worst yield a bad plan. FAIL-CLOSED: if Codex is unavailable it plans only.
# Enable (opt-in, applies nightly at 03:37): MEMORY_NIGHTLY_APPLY=1 ./install.sh  (or
# `systemctl --user enable --now memory-nightly-apply.timer` — safe; Persistent=false
# so --now never catch-up-runs). Runner env:
# DRYRUN=1 (test: plan+review only), MAX_CONSOLIDATIONS, MAX_DELETIONS,
# NIGHTLY_ALLOW_FAILOPEN=1 (apply even if Codex is down — NOT recommended).

# ── Vector store (OPTIONAL) ─────────────────────────────────────────────────
# A Qdrant index over the .md store for semantic recall + fast (ANN) dedup. The
# .md files remain the source of truth; Qdrant is a rebuildable index over them.
# OFF by default: with this disabled OR Qdrant unreachable, engram falls back to
# pure markdown (the in-memory cosine duplicate finder + graph recall) — nothing
# breaks. Embeddings reuse engram_llm.embed() (768-dim nomic), so the vector space
# matches the graph exactly. Enable with `./install.sh --vector`, then start Qdrant:
#   cd ~/.claude/vector && docker compose up -d
vector_store:
  enabled: false                 # master switch (parallels the optional --graph)
  provider: qdrant               # qdrant (only backend for now)
  url: "http://127.0.0.1:6333"   # loopback Qdrant
  api_key: ""                    # for Qdrant Cloud; blank for local
  collection: "engram_memory"    # base name; per tenant it becomes engram_memory__<tenant>
  wiki_collection: "engram_wiki" # base name for the wiki corpus (chunked documents)
  on_disk: false                 # true = store vectors on disk (less RAM, slower search)
  timeout_seconds: 30
  recall:
    default_k: 6                 # default k for vector search / recall hits
    threshold: 0.0               # min cosine for a search hit (0 = no floor)
  duplicate_finder:
    use_vector_store: true       # light pass uses Qdrant ANN instead of O(n^2) cosine when enabled

# ── Hybrid recall (Reciprocal Rank Fusion) ──────────────────────────────────
# Fuse the recall paths — graph (associative/temporal), vector (dense semantic),
# and keyword (BM25 lexical) — into one ranking keyed by the .md filename, so the
# indexes are greater than the sum. The full 3-way `memory_recall` /
# `memory_recall_hybrid` lives on the engram-rust MCP server, which embeds the
# query once and degrades to vector+keyword on no-graph installs. (engram-graph and
# engram-vector no longer expose recall — each re-embedded the query.)
# Each ranker degrades independently — a disabled/down backend just drops out.
recall:
  scope_to_slug: true            # restrict vector/hybrid recall to the current store's slug
  # Ceiling for ONE recall, used to bound the Graphiti child process so a stalled
  # Neo4j can never hang a caller forever. This is NOT the per-prompt budget —
  # that is inject.timeout_ms below, and it is deliberately much shorter. An
  # explicit CLI/MCP/API recall may wait for a ~4s Graphiti query; a prompt may not.
  timeout_ms: 15000
  hybrid:
    enabled: true
    k_rrf: 60                    # RRF constant (standard 60); damps low-rank contributions
    default_k: 6                 # how many fused memories a recall returns
    weights: { graph: 1.0, vector: 1.0, keyword: 1.0 }   # per-ranker RRF weight
  # Auto-recall: the UserPromptSubmit hook (hooks/memory-recall-inject.py, or
  # rust/engram-recall-hook) puts the memories relevant to each prompt in front of
  # Claude without waiting for it to call a recall tool. It injects NAMES +
  # DESCRIPTIONS ONLY (never memory bodies) and never repeats a memory or a fact
  # within one session, so a long session costs a few hundred tokens in total
  # rather than k memories x every prompt.
  #
  # Both hooks run in FAST mode — local BM25 + vector + one graph fact query, never
  # the Graphiti child — because the full path cannot fit in this budget. A prompt
  # that waits is worse than a prompt without recall, so the hook always fails open.
  inject:
    enabled: true                # false = hook goes quiet (no need to unmerge it)
    k: 4                         # memories per injection (post-dedup)
    max_facts: 6                 # 1-hop graph facts per injection
    timeout_ms: 2500             # WALL-CLOCK budget for the whole injection

# Local MCP servers wired into interactive sessions. Recall lives on `engram-rust`
# (the Rust engram-mcp binary); `engram-graph` (graph/mg_mcp_server.py) and the
# optional `engram-vector` (vector/vector_mcp_server.py) provide only their unique
# tools, so a single recall embeds the query once instead of once per server.
mcp_servers:
  engram-rust:
    note: "Single recall path: memory_recall / memory_recall_hybrid (graph+vector+keyword, embeds once) + wiki_search / wiki_fetch / wiki_write"
  engram-graph:
    note: "Graphiti/Neo4j graph tools: memory_search_facts / memory_neighbors / memory_stats (recall is on engram-rust)"
  engram-vector:
    note: "Qdrant inspection (optional): memory_vector_search / memory_vector_stats (recall is on engram-rust)"

# Scheduling — the installer builds the systemd timer / daemon cadence from these.
schedule:
  times: ["03:30", "15:30"]

# Telegram activity log — DM a one-line summary of every unattended maintenance
# run (harvested/staged/graduated), not just approvals. The weekly digest is separate.
# telegram:
#   activity_log: true
