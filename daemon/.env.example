# engram daemon stack config — copy to `.env` and fill in. NEVER commit the real .env.

# Neo4j password (also used by the daemon to connect). Generate a strong one:
#   openssl rand -hex 24
NEO4J_PASSWORD=

# Claude-only backend: an Anthropic API key for headless `claude -p`. Leave blank
# if BACKEND=ollama.
ANTHROPIC_API_KEY=

# Generation backend: claude (no GPU) | ollama (set OLLAMA host in engram.yaml)
BACKEND=claude

# The store slug to operate on — must match ~/.claude/projects/<slug>/memory of the
# store you mount. For a home dir /home/alice it is "-home-alice".
CLAUDE_MEMORY_SLUG=

# Path on the host to a ~/.claude-style dir holding engram.yaml + projects/<slug>/memory
# + logs. Mounted at /root/.claude in the container.
ENGRAM_CLAUDE_HOME=./claude-home

# OPTIONAL — central/shared deployment: sync the store to a Git repo (owner/repo).
# Requires a GitHub token in the container's gh auth. Leave blank for local-only.
CLAUDE_MEMORY_REPO=
