graph/sync_state.json
graph/extractions/
graph/export/
graph/neo4j/
vector/sync_state.json
vector/qdrant_storage/
daemon/neo4j/
daemon/claude-home/
logs/
*.log

# Node (if a real Vite build is added later)
node_modules/
ui/dist/
